# TEIA-users Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection (defaults in application.properties work for local dev)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/teiacore
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=password

# =============================================================================
# JWT Authentication
# =============================================================================
# Secret key for signing JWTs (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-here-must-be-at-least-32-characters

# Optional: JWT expiry times in milliseconds
# JWT_ACCESS_EXPIRY_MS=900000       # 15 minutes
# JWT_REFRESH_EXPIRY_MS=604800000   # 7 days

# =============================================================================
# Encryption (REQUIRED for production)
# =============================================================================
# AES-256-GCM encryption key for sensitive credentials stored at rest.
# Must be a base64-encoded 32-byte (256-bit) key.
# Generate with: openssl rand -base64 32
#
# Example (DO NOT use in production - generate your own):
ENCRYPTION_KEY=K7gNU3sdo+OL0wNhqoVWhr3g6s1xYv72ol/pe/Unols=

# Set to true to migrate existing plaintext data to encrypted format (run once)
# ENCRYPTION_MIGRATION_ENABLED=false

# =============================================================================
# TEIA Core Client
# =============================================================================
# Shared secret for HMAC signing of requests to TEIA Core
# Must match TEIA Core's INTERNAL_SECRET
INTERNAL_SECRET=teia-local-dev-secret-change-in-prod

# TEIA Core service URL
# TEIA_CORE_BASE_URL=http://localhost:8000
